LLAMA_CHAT_API_BASE=http://127.0.0.1:11434/v1
LLAMA_CHAT_API_KEY=ollama
LLAMA_CHAT_MODEL=llama3.1:8b
LLAMA_CHAT_TIMEOUT_SEC=3000
LLAMA_CHAT_TEMPERATURE=0.2

# Qdrant (атомарные утверждения: вектор + payload text/document_id/author)
QDRANT_URL=http://127.0.0.1:6333
# Для Qdrant Cloud: задать ключ; локально оставить пустым
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=atomic_statements
# Размерность должна совпадать с моделью эмбеддингов
QDRANT_VECTOR_SIZE=384
# COSINE | DOT | EUCLID
QDRANT_DISTANCE=COSINE
QDRANT_TIMEOUT_SEC=30
QDRANT_SEARCH_TOP_K=15
# Порог по score Qdrant (для COSINE/DOT выше — ближе по смыслу); пусто — без отсечения
QDRANT_SCORE_THRESHOLD=0.35
QDRANT_UPSERT_BATCH_SIZE=128
