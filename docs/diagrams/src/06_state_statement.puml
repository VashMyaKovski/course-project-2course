@startuml
title "State-диаграмма: Жизненный цикл атомарного утверждения"

[*] --> RawChunk : "Загрузка документа"

state RawChunk : Текст из документа, разбитый на сегменты
state Extracting : LLM извлекает атомарные утверждения
state Decontextualizing : LLM заменяет местоимения на сущности
state Embedding : Sentence-BERT генерирует вектор
state Active : Факт доступен для поиска
state PairSelected : Факт выбран для NLI-классификации
state NLIProcessing : deBERTa классифицирует пару
state Flagged : Подтверждённое противоречие
state Deprecated : Факт устарел по дате
state Error : Ошибка обработки
state Archived : Не участвует в поиске

RawChunk --> Extracting : "Разбиение на части"
Extracting --> Decontextualizing : "Факты извлечены"
Extracting --> Error : "Сбой LLM"
Decontextualizing --> Embedding : "Местоимения заменены"
Decontextualizing --> Error : "Сбой деконтекстуализации"
Embedding --> Active : "Вектор создан"
Embedding --> Error : "Сбой Sentence-BERT"
Active --> PairSelected : "Найден похожий факт"
Active --> Deprecated : "Истечение срока актуальности"
PairSelected --> NLIProcessing : "Пара сформирована"
PairSelected --> Active : "Сброс сравнения"
NLIProcessing --> Flagged : "Обнаружено противоречие"
NLIProcessing --> Active : "Конфликтов нет"
NLIProcessing --> Error : "Сбой NLI-модели"
Flagged --> Archived : "Архивация"
Flagged --> Active : "Противоречие исправлено"
Deprecated --> Archived : "Архивация"
Error --> Extracting : "Повторная попытка"
Error --> [*] : "Конец"
Archived --> [*]
@enduml