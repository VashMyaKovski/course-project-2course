@startuml ER_Diagram
title "ER диаграмма: система поиска фактологических противоречий"

skinparam shadowing false
skinparam monochrome true
skinparam packageStyle rectangle

' === СТИЛИ ===
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
}
skinparam diamond {
  BackgroundColor White
  BorderColor Black
}

' === СУЩНОСТИ ===
rectangle "SourceDocument" as DOC
rectangle "Chunk" as CHK
rectangle "AtomicStatement" as STMT
rectangle "StatementContext" as CTX
rectangle "ContradictionPair" as CP
rectangle "FactTopic" as TOPIC

' === АТРИБУТЫ ===

' SourceDocument
usecase "<u>id</u>" as DOC_id
usecase "name" as DOC_name
usecase "content" as DOC_content
usecase "uploaded_at" as DOC_date
usecase "source_type" as DOC_type
DOC -- DOC_id
DOC -- DOC_name
DOC -- DOC_content
DOC -- DOC_date
DOC -- DOC_type

' Chunk
usecase "<u>id</u>" as CHK_id
usecase "chunk_index" as CHK_idx
usecase "text" as CHK_text
CHK -- CHK_id
CHK -- CHK_idx
CHK -- CHK_text

' AtomicStatement
usecase "<u>id</u>" as STMT_id
usecase "original_text" as STMT_orig
usecase "decontextualized" as STMT_decon
usecase "embedding" as STMT_emb
STMT -- STMT_id
STMT -- STMT_orig
STMT -- STMT_decon
STMT -- STMT_emb

' StatementContext
usecase "<u>id</u>" as CTX_id
usecase "temporal_scope" as CTX_temp
usecase "geographic_scope" as CTX_geo
CTX -- CTX_id
CTX -- CTX_temp
CTX -- CTX_geo

' ContradictionPair
usecase "<u>id</u>" as CP_id
usecase "nli_relation" as CP_nli
usecase "confidence_score" as CP_conf
CP -- CP_id
CP -- CP_nli
CP -- CP_conf

' FactTopic
usecase "<u>id</u>" as TOPIC_id
usecase "topic_name" as TOPIC_name
TOPIC -- TOPIC_id
TOPIC -- TOPIC_name

' === СВЯЗИ (Используем Diamond для отличия от сущностей) ===
() "Contains" as R_contains
() "Extracted From" as R_extracted
() "Has Context" as R_context
() "Participates In" as R_participates
() "Belongs To" as R_belongs

' Соединения
DOC "1" -- R_contains
R_contains -- "N" CHK

CHK "1" -- R_extracted
R_extracted -- "N" STMT

STMT "1" -- R_context
R_context -- "0..1" CTX

' Исправлено: N:M, так как в паре противоречий 2 утверждения,
' а одно утверждение может противоречить многим другим.
STMT "N" -- R_participates
R_participates -- "M" CP

' Исправлено: N:M, так как утверждение может иметь несколько тегов (тем)
STMT "N" -- R_belongs
R_belongs -- "M" TOPIC

@enduml