@startuml 02_usecase_diagram
title "Use-Case диаграмма: Сценарии использования системы"

left to right direction

actor "Пользователь" as User
actor "LLM-модуль" as LLM
actor "Embedding-модель" as Embed
actor "NLI-модель" as NLI

rectangle "RAG Knowledge Base System" {
  
  usecase "UC1: Загрузить документ" as UC1
  usecase "UC2: Извлечь атомарные утверждения" as UC2
  usecase "UC3: Деконтекстуализировать факты" as UC3
  usecase "UC4: Проверить на противоречия" as UC4
  usecase "UC5: Просмотреть отчёт" as UC5
  
  usecase "UC1.1: Разбить текст на чанки" as UC1_1
  usecase "UC2.1: Найти местоимения и сущности" as UC2_1
  usecase "UC2.2: Заменить местоимения" as UC2_2
  usecase "UC3.1: Сгенерировать вектор" as UC3_1
  usecase "UC3.2: Сохранить в БД" as UC3_2
  
  usecase "UC4.1: Найти факты по теме" as UC4_1
  usecase "UC4.2: Сформировать пары" as UC4_2
  usecase "UC4.3: Классифицировать через NLI" as UC4_3
  usecase "UC4.4: Фильтровать по уверенности" as UC4_4
  
  UC1 ..> UC1_1 : <<include>>
  UC2 ..> UC2_1 : <<include>>
  UC2 ..> UC2_2 : <<include>>
  UC3 ..> UC3_1 : <<include>>
  UC3 ..> UC3_2 : <<include>>
  UC4 ..> UC4_1 : <<include>>
  UC4 ..> UC4_2 : <<include>>
  UC4 ..> UC4_3 : <<include>>
  UC4 ..> UC4_4 : <<extend>>
}

User --> UC1
User --> UC4
User --> UC5
LLM --> UC2
LLM --> UC3
Embed --> UC3_1
NLI --> UC4_3

note right of UC3
  Деконтекстуализация:
  LLM заменяет местоимения на сущности
end note

@enduml